    <script id="optimized-wallpaper-script">
(function () {
    const box = document.querySelector('.wallpaper-slideshow');
    if (!box) return;

    const overlay = box.querySelector('.wallpaper-overlay');
    const files = Array.from({ length: 100 }, (_, i) => `${i + 1}.gif`);
    let index = 0;
    let active = null;

    function showNext() {
        const src = 'nsfwwallpaper/' + files[index];

        const img = document.createElement('img');
        img.className = 'wallpaper-slide';
        img.alt = '';
        img.decoding = 'async';
        img.loading = 'eager';
        img.src = src;

        img.addEventListener('load', function () {
            if (active) {
                active.classList.remove('active');
                setTimeout(() => {
                    if (active && !active.classList.contains('active')) {
                        active.remove();
                    }
                }, 900);
            }

            box.insertBefore(img, overlay);
            requestAnimationFrame(() => img.classList.add('active'));
            active = img;
        }, { once: true });

        img.addEventListener('error', function () {
            img.remove();
        }, { once: true });

        index = (index + 1) % files.length;
    }

    // First wallpaper immediately, then change every 2 seconds.
    showNext();
    setInterval(showNext, 2000);
})();
</script>

